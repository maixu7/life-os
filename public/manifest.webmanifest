{
  "name": "Life OS",
  "short_name": "Life OS",
  "description": "Your personal daily life tracker",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0716",
  "theme_color": "#0b0716",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Quick log", "url": "/quick", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Snap anything", "short_name": "Snap", "url": "/quick?hub=camera", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
